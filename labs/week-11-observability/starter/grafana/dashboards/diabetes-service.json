    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 minus (5xx responses / the number the 99% target allows) over the rolling 30-day window. The 0.01 in the denominator is the error budget from slo.yaml, and tests/test_dashboard.py recomputes it from that file rather than trusting the literal here. Read it as a decision-making device, not a score: a budget that has never been touched means the target is too low, and reliability bought is latency headroom or velocity not bought.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []

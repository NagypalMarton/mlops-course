    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Synthesised by Prometheus on every scrape: 1 if the scrape succeeded, 0 if it did not. You get it for free from the act of scraping, and it covers the hole a ratio-based SLI structurally cannot — a service with no traffic has a perfect error ratio. This is what ServiceDown alerts on.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"

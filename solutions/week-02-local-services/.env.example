# Copy this file to .env and adjust values as needed.
# Never commit .env — it is git-ignored.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflowdb

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=mlflow-artifacts

# ── Host port mapping ─────────────────────────────────────────────────────────
# Container-internal ports stay at each tool's native default; only the HOST
# ports below are remapped into the 55xx block to avoid clashes with common
# local ports (e.g. macOS AirPlay uses 5000; a local Postgres uses 5432).
MLFLOW_PORT=5500          # host → container 5000 (MLflow UI)
MINIO_API_PORT=5510       # host → container 9000 (MinIO S3 API)
MINIO_CONSOLE_PORT=5511   # host → container 9001 (MinIO console)
POSTGRES_HOST_PORT=5532   # host → container 5432 (Postgres)

# ── Pipeline (Python client) ──────────────────────────────────────────────────
# These are consumed by the Python pipeline running on the host.
MLFLOW_TRACKING_URI=http://127.0.0.1:5500
MLFLOW_EXPERIMENT_NAME=diabetes-week2

PIPELINE_RANDOM_SEED=42
PIPELINE_DATA_PATH=data/diabetes.csv
PIPELINE_TEST_SIZE=0.25
PIPELINE_MAX_ITER=1000
